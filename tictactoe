b = [" "] * 9
w = [(0,1,2),(3,4,5),(6,7,8),
     (0,3,6),(1,4,7),(2,5,8),
     (0,4,8),(2,4,6)]

for i in range(9):
    for r in range(0, 9, 3):
        print("|", " | ".join(b[r:r+3]), "|")
        print("-------------")

    n = int(input("Position (0-8): "))
    b[n] = "X" if i % 2 == 0 else "O"
    p = b[n]

    if any(all(b[j] == p for j in x) for x in w):
        print(p, "wins!")
        break
else:
    print("Draw!")
